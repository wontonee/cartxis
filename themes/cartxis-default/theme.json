{
    "name": "Cartxis Default",
    "slug": "cartxis-default",
    "description": "A vibrant, mobile-first storefront theme with UI Editor homepage layouts, quick view, and modern blue retail polish.",
    "version": "2.0.0",
    "author": "Cartxis Team",
    "author_url": "https://cartxis-commerce.com",
    "screenshot": "screenshots/theme-preview.svg",
    "is_default": true,
    "supports": [
        "widgets",
        "menus",
        "custom-logo",
        "custom-colors",
        "responsive",
        "dark-mode"
    ],
    "settings": {
        "colors": {
            "primary": "#2563eb",
            "secondary": "#1e40af",
            "accent": "#0ea5e9",
            "success": "#10b981",
            "danger": "#ef4444",
            "warning": "#f59e0b",
            "info": "#3b82f6"
        },
        "typography": {
            "font_family": "Inter, sans-serif",
            "font_size": "16px",
            "heading_font": "Inter, sans-serif"
        },
        "layout": {
            "container_width": "1280px",
            "sidebar_width": "300px",
            "header_style": "default",
            "footer_style": "default"
        },
        "features": {
            "sticky_header": true,
            "back_to_top": true,
            "wishlist": true,
            "quick_view": true,
            "product_zoom": true,
            "show_platform_branding": false
        }
    }
}
